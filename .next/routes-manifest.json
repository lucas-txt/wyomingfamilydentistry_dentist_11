      "routeKeys": {},
      "namedRegex": "^/new\\-patients(?:/)?$"
    },
    {
      "page": "/opt-out-preferences",
      "regex": "^/opt\\-out\\-preferences(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/opt\\-out\\-preferences(?:/)?$"
    },
    {
      "page": "/our-office",
      "regex": "^/our\\-office(?:/)?$",
