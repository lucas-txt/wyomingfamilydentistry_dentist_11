51:["$","h2","28",{"id":"legal-section-28","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"3. How we respond to Do Not Track signals & Global Privacy Control"}]
52:["$","p","29",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"Our website responds to and supports the Do Not Track (DNT) header request field. If you turn DNT on in your browser, those preferences are communicated to us in the HTTP request header, and we will not track your browsing behavior."}]
53:["$","h2","30",{"id":"legal-section-30","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"4. Cookies"}]
54:["$","p","31",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"Our website uses cookies. For more information about cookies, please refer to our Cookie Policy on our Opt-out preferences webpage."}]
55:["$","p","32",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"We have concluded a data processing agreement with Google."}]
56:["$","p","33",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"Google may not use the data for any other Google services."}]
57:["$","h2","34",{"id":"legal-section-34","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"5. Security"}]
58:["$","p","35",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"We are committed to the security of personal data. We take appropriate security measures to limit abuse of and unauthorized access to personal data. This ensures that only the necessary persons have access to your data, that access to the data is protected, and that our security measures are regularly reviewed."}]
59:["$","h2","36",{"id":"legal-section-36","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"6. Third-party websites"}]
5a:["$","p","37",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"This privacy statement does not apply to third-party websites connected by links on our website. We cannot guarantee that these third parties handle your personal data in a reliable or secure manner. We recommend you read the privacy statements of these websites prior to making use of these websites."}]
5b:["$","h2","38",{"id":"legal-section-38","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"7. Amendments to this privacy statement"}]
5c:["$","p","39",{"className":"text-pretty text-[15.5px] leading-7 text-ink-soft sm:text-base sm:leading-8 mt-4","children":"We reserve the right to make amendments to this privacy statement. It is recommended that you consult this privacy statement regularly in order to be aware of any changes. In addition, we will actively inform you wherever possible."}]
5d:["$","h2","40",{"id":"legal-section-40","className":"scroll-mt-32 text-balance font-display tracking-[-0.03em] text-ink mt-12 text-[1.75rem] first:mt-0 sm:text-3xl","children":"8. Accessing and modifying your data"}]
