12:["$","section",null,{"className":"py-16 sm:py-24","children":["$","div",null,{"className":"container-x","children":[["$","div",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"mb-4 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-teal","children":[["$","span",null,{"className":"inline-block size-1.5 rounded-full bg-lime"}],"The people behind the practice"]}],["$","h2",null,{"className":"text-balance text-4xl leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl lg:text-[3.5rem]","children":"Care that starts with knowing you."}],["$","p",null,{"className":"mt-5 max-w-2xl text-pretty text-base leading-7 text-ink-soft sm:text-lg sm:leading-8","children":"Our team brings different strengths to the same goal: helping every patient feel informed, comfortable, and well cared for."}]]}],["$","div",null,{"className":"space-y-10 sm:space-y-14 mt-12","children":[["$","$L10","Emily Boehm DDS",{"delay":0.05,"children":["$","article",null,{"id":"emily-boehm-dds","className":"grid scroll-mt-32 gap-7 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-12","children":[["$","div",null,{"className":"relative overflow-hidden rounded-4xl border border-white/60 shadow-soft lg:order-1","children":["$","div",null,{"className":"relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/5]","children":[["$","$L11",null,{"src":"/assets/images/team-emily.webp","alt":"Dr. Emily Boehm of Wyoming Family Dentistry","fill":true,"loading":"eager","sizes":"(max-width: 1024px) 100vw, 38vw","className":"object-cover object-top"}],["$","div",null,{"aria-hidden":"true","className":"absolute inset-0 bg-linear-to-t from-ink/55 via-transparent to-transparent"}],["$","p",null,{"className":"absolute bottom-5 left-5 right-5 font-display text-2xl text-cream","children":"Emily Boehm DDS"}]]}]}],["$","div",null,{"className":"lg:order-2","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-[11px] font-semibold