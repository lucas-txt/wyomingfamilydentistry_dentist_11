2c:["$","section",null,{"className":"relative overflow-hidden py-20 sm:py-28","children":["$","div",null,{"className":"container-x","children":[["$","$L25",null,{"children":["$","div",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"mb-4 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.22em] text-teal","children":[["$","span",null,{"className":"inline-block size-1.5 rounded-full bg-lime"}],"Testimonials"]}],["$","h2",null,{"className":"text-balance text-4xl leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl lg:text-[3.5rem]","children":"What people are saying"}],["$","p",null,{"className":"mt-5 max-w-2xl text-pretty text-base leading-7 text-ink-soft sm:text-lg sm:leading-8","children":"Real words from patients who trust Wyoming Family Dentistry with their smiles."}]]}]}],["$","div",null,{"className":"mt-10 grid gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-start","children":[["$","$L25",null,{"delay":0.08,"children":["$","$L4c",null,{"testimonials":[{"quote":"Emily and her team are the best! She is the most gentle dentist I’ve ever been too. She’s our go to place for cleanings, cavities, cracked teeth, crowns and recommendations to other professionals for other work, e.g. tooth extractions and root canals Her team is very professional and friendly! If you have any dental concerns, go there!","author":"Brian B.","source":"Patient review"},{"quote":"Every one here is super friendly and thorough. The staff went above and beyond for me after having to switch dental offices after a horrible experience at my last one. The front desk is quick and efficient. They were able to help me with all of my insurance and billing needs with no fuss.","author":"Briana P.","source":"Patient review"},{"quote":"I’m a new patient, and had my first appointment today. I had to wait a while to get an appt, but I’m sure glad that I did! The staff was very warm and welcoming, and I received the best cleaning that I’ve ever had.","author":"Craymon M.","source":"Patient review"},{"quote":"We never fail to have a great patient experience in Emily’s practice. She and her staff are kind and gentle and provide clear explanations of their treatments. We have been going to this practice for over twenty years!","author":"Angie M.","source":"Patient review"},{"quote":"I always have a great experience every time I visit Wyoming Family Dentistry. I have already referred them to several people and will continue to do so. I appreciate great customer service and going to the dentist is usually dreaded, but great conversation, friendly staff and fast service always makes a difference!!","author":"Katie H.","source":"Patient review"},{"quote":"So my 5 year old had two small cavities unfortunately. Emily Price Boehm at Wyoming Family Dentistry did an amazing job with her. Fillings required two shots because of different areas of the mouth. HEIDI didn’t cry and was a champ through the entire procedure! Thank you Dr. Boehm and Gabby (assistant) for being so patient and providing a positive dental experience for my little girl!","author":"Featured Google Review","source":"Google review","featured":true}]}]}],["$","$L25",null,{"delay":0.14,"children":["$","aside",null,{"className":"relative overflow-hidden rounded-4xl bg-ink p-7 text-cream shadow-soft sm:p-8","children":[["$","div",null,{"className":"grain absolute inset-0","aria-hidden":"true"}],["$","div",null,{"aria-hidden":"true","className":"absolute -right-16 -top-20 size-52 rounded-full bg-[radial-gradient(circle_at_center,_rgba(182,208,106,0.3),_transparent_68%)] blur-2xl"}],["$","$L16",null,{"src":"/assets/images/stars.webp","alt":"Five stars","width":300,"height":69,"loading":"eager","className":"relative h-5 w-auto"}],"$L4d","$L4e","$L4f"]}]}]]}]]}]}]
